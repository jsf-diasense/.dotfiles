[
    // ================================
    // Pane navigation (Vim style)
    // ================================
    {
        "key": "ctrl+j",
        "command": "workbench.action.navigateDown",
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.navigateUp",
    },
    {
        "key": "ctrl+h",
        "command": "workbench.action.navigateLeft",
    },
    {
        "key": "ctrl+l",
        "command": "workbench.action.navigateRight",
    },
    {
        "key": "ctrl+h",
        "command": "workbench.action.terminal.focusPreviousPane",
        "when": "terminalFocus && focusedView == 'terminal'"
    },
    {
        "key": "ctrl+l",
        "command": "workbench.action.terminal.focusNextPane",
        "when": "terminalFocus &&  focusedView == 'terminal'"
    },
    {
        "key": "ctrl+shift+j",
        "command": "workbench.action.terminal.toggleTerminal",
    },

    // ================================
    // Move editors between groups
    // ================================

    {
        "key": "ctrl+shift+h",
        "command": "workbench.action.moveEditorToLeftGroup"
    },
    {
        "key": "ctrl+shift+l",
        "command": "workbench.action.moveEditorToRightGroup"
    },

    // ================================
    // Quick Open navigation
    // ================================

    {
        "key": "ctrl+j",
        "command": "workbench.action.quickOpenSelectNext",
        "when": "inQuickOpen"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.quickOpenSelectPrevious",
        "when": "inQuickOpen"
    },

    // ================================
    // Suggestion navigation
    // ================================

    {
        "key": "ctrl+j",
        "command": "selectNextSuggestion",
        "when": "suggestWidgetVisible"
    },
    {
        "key": "ctrl+k",
        "command": "selectPrevSuggestion",
        "when": "suggestWidgetVisible"
    },

    // ================================
    // Code action menu navigation
    // ================================

    {
        "key": "ctrl+j",
        "command": "selectNextCodeAction",
        "when": "codeActionMenuVisible"
    },
    {
        "key": "ctrl+k",
        "command": "selectPrevCodeAction",
        "when": "codeActionMenuVisible"
    },

    // ================================
    // Terminal
    // ================================

    {
        "key": "ctrl+space ctrl+,",
        "command": "workbench.action.terminal.split",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+shift+5",
        "command": "-workbench.action.terminal.split"
    },

    {
        "key": "ctrl+f",
        "command": "workbench.action.terminal.sendSequence",
        "args": { "text": "\u0006" },
        "when": "terminalFocus"
    },

    // ================================
    // Explorer
    // ================================

    {
        "key": "ctrl+n",
        "command": "explorer.newFile"
    },
    {
        "key": "ctrl+shift+n",
        "command": "explorer.newFolder"
    },

    {
        "key": "ctrl+p",
        "command": "workbench.action.quickOpen"
    },

    // ================================
    // Copilot / Chat
    // ================================
    {
        "key": "ctrl+\\",
        "command": "-workbench.action.splitEditor"
    },
    {
        "key": "ctrl+\\",
        "command": "workbench.action.terminal.newWithProfile",
        "args": {
            "profileName": "OpenCode",
            "location": "editor",
        }
    },
    {
        "key": "ctrl+shift+\\",
        "command": "workbench.action.terminal.newWithProfile",
        "args": {
            "profileName": "OpenCode -c",
            "location": "editor",
        }
    },
    // ================================
    // Debugger
    // ================================

    {
        "key": "ctrl+5",
        "command": "workbench.action.debug.start",
        "when": "debuggersAvailable && debugState == 'inactive'"
    },
    {
        "key": "ctrl+5",
        "command": "workbench.action.debug.continue",
        "when": "debugState == 'stopped'"
    },
    {
        "key": "ctrl+6",
        "command": "workbench.action.debug.pause",
        "when": "debugState == 'running'"
    },
    {
        "key": "ctrl+shift+5",
        "command": "workbench.action.debug.restart",
        "when": "inDebugMode"
    },
    {
        "key": "ctrl+shift+0",
        "command": "workbench.action.debug.disconnect",
        "when": "focusedSessionIsAttach && inDebugMode"
    },

    // ================================
    // Code / editor
    // ================================

    {
        "key": "ctrl+,",
        "command": "editor.action.marker.next",
        "when": "editorFocus"
    },

    {
        "key": "ctrl+shift+i",
        "command": "python.setInterpreter"
    },

    {
        "key": "ctrl+shift+r",
        "command": "editor.action.rename",
        "when": "editorHasRenameProvider && editorTextFocus && !editorReadonly"
    },

    {
        "key": "f2",
        "command": "-editor.action.rename"
    },

    // ================================
    // Inline AI suggestions
    // ================================

    {
        "key": "alt+\\",
        "command": "editor.action.inlineSuggest.trigger"
    },

    {
        "key": "ctrl+f",
        "command": "editor.action.inlineSuggest.acceptNextLine",
        "when": "inlineSuggestionVisible && editorTextFocus"
    },

    // ================================
    // UI
    // ================================

    {
        "key": "ctrl+shift+b",
        "command": "workbench.action.toggleSidebarVisibility"
    },

    {
        "key": "ctrl+b",
        "command": "-workbench.action.toggleSidebarVisibility"
    },

    {
        "key": "ctrl+b",
        "command": "editor.debug.action.toggleBreakpoint",
        "when": "debuggersAvailable && editorTextFocus"
    },

    {
        "key": "f9",
        "command": "-editor.debug.action.toggleBreakpoint"
    },

    {
        "key": "ctrl+shift+w",
        "command": "workbench.action.toggleMaximizeEditorGroup"
    },

    {
        "key": "ctrl+shift+t",
        "command": "workbench.view.extension.test"
    },
    {
        "key": "ctrl+m",
        "command": "-editor.action.toggleTabFocusMode"
    },
]