# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Your preferred terminal emulator
set $term kitty
# Your preferred application launcher
set $menu wmenu-run

include /etc/sway/config-vars.d/*

### Output configuration
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
# This is commented in Debian, because the Sway wallpaper files are in a separate
# package `sway-backgrounds`. Installing this package drops a config file to
# /etc/sway/config.d/
# output * bg /usr/share/backgrounds/sway/Sway_Wallpaper_Blue_1920x1080.png fill
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration
#
# Example configuration:
#

# Had to install swayidle separately.
# NOTE: we deliberately never suspend, AND never let the compositor power the
# outputs off. On this hybrid Intel+NVIDIA + DisplayLink ThinkPad, any
# compositor-driven display power transition can hard-hang a GPU and force a
# reboot:
#   - s2idle resume: i915 PHY fails to power up.
#   - DPMS 'output * power off' -> 'power on': on 2026-06-30, undocked on the
#     internal i915 eDP panel, the panel failed to re-power on activity -> black
#     screen, no recovery, had to hold the power button (next boot's ext4 journal
#     recovery confirmed the unclean cut).
# So idle ONLY locks; the screen stays on (locked). To blank when undocked,
# close the lid -- the lid:on bindswitch below disables eDP-1 on its own.
exec swayidle -w \
    timeout 300 'swaylock -f -c 000000'

# Kill the other auto-suspend triggers for the same reason (see note above):
#  - gnome-settings-daemon would suspend on idle (esp. on battery, 15 min);
#  - closing the lid would suspend via logind (handled by a logind drop-in,
#    /etc/systemd/logind.conf.d/10-nosuspend.conf -- not a dotfile).
exec gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type 'nothing'
exec gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-battery-type 'nothing'
# Closing the lid does nothing (no suspend, no lock): sway turns off the internal
# eDP panel by itself, and when docked it's already disabled, so the DisplayLink
# screens keep working with the lid shut. Lock manually with the lock binding.

### Input configuration
#
# Example configuration:
#
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}
input type:keyboard {
    xkb_layout "us,es,dk"
}

bindsym $mod+n exec /home/jorge/.local/bin/toggle-kb

# Corsair driver, needs to be loaded to remap the G1 keys
exec_always ckb-next --background

# You can also configure each device individually.
